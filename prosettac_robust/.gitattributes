# Immutable molecular artifacts are hash-bound and must retain exact bytes.
workflow/ligand_params/** -text
workflow/ligand_params/**/*.log binary
workflow/ligand_params/**/*.pkl binary
# Experimental frozen source copies retain inherited upstream whitespace.
linker_method_review/candidate_workflow/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
linker_method_review/candidate_torsion_workflow/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Preserve hash-bound audit tables; csv.DictWriter emitted standard CRLF.
existing_result_audit/** -text whitespace=-blank-at-eol,-blank-at-eof
existing_result_audit/**/*.tsv whitespace=cr-at-eol,-blank-at-eol

# Matplotlib-generated, hash-bound SVG paths retain their original spacing.
existing_result_audit/**/figures/*.svg -text whitespace=-blank-at-eol

# Missing final TSV fields require trailing delimiters; preserve their exact bytes.

# Preserve exact pytest failure logs; trailing report whitespace is forensic data.
existing_result_audit/**/*.txt whitespace=-blank-at-eol
existing_result_audit/**/*.log whitespace=-blank-at-eol,-blank-at-eof

# Regression stdout is immutable evidence, including warning-layout spaces.
validation_controls/regression/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
