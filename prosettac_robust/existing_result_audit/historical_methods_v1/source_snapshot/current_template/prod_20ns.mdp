; Production MD — 300 K, 1 bar, 20 ns (screening run)
integrator      = md
nsteps          = 10000000      ; 20 ns at 2 fs timestep
dt              = 0.002

; Output — every 100 ps
nstxout         = 0
nstvout         = 0
nstfout         = 0
nstxout-compressed = 50000      ; compressed trajectory every 100 ps
nstenergy       = 50000
nstlog          = 50000
compressed-x-precision = 1000

cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 10
rcoulomb        = 1.6
rvdw            = 1.6
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.16

; Temperature — V-rescale
tcoupl          = V-rescale
tc-grps         = Protein  Other  Water_and_ions
tau_t           = 0.1      0.1    0.1
ref_t           = 300      300    300

; Pressure — Parrinello-Rahman
pcoupl          = Parrinello-Rahman
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = 1.0
compressibility = 4.5e-5

; Constraints
constraints     = h-bonds
constraint_algorithm = LINCS
lincs_iter      = 1
lincs_order     = 4

gen_vel         = no

; GPU offload — use RTX 5090
; Run with: gmx mdrun -ntmpi 1 -ntomp 8 -gpu_id 0 -nb gpu -pme gpu -bonded gpu
pbc             = xyz
